{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "env": {
        "APP_ENV": "dev"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "APP_ENV": "smoke"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "APP_ENV": "prod"
      },
      "distribution": "store"
    }
  },
  "submit": {
    "production": {}
  }
}
