{
  "name": "splitivo-mobile",
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "dotenv -e .env.dev -- expo start",
    "start:smoke": "dotenv -e .env.smoke -- expo start",
    "start:prod": "dotenv -e .env.prod -- expo start",
    "ios": "expo run:ios",
    "ios:dev": "dotenv -e .env.dev -- expo run:ios --device",
    "ios:smoke": "dotenv -e .env.smoke -- expo run:ios --device",
    "ios:prod": "dotenv -e .env.prod -- expo run:ios --device",
    "android": "expo run:android",
    "android:dev": "dotenv -e .env.dev -- expo run:android --device",
    "android:smoke": "dotenv -e .env.smoke -- expo run:android --device",
    "android:prod": "dotenv -e .env.prod -- expo run:android --device",
    "prebuild-ios:dev": "dotenv -e .env.dev -- expo prebuild --platform ios --clean",
    "prebuild-ios:smoke": "dotenv -e .env.smoke -- expo prebuild --platform ios --clean",
    "prebuild-ios:prod": "dotenv -e .env.prod -- expo prebuild --platform ios --clean",
    "prebuild-android:dev": "dotenv -e .env.dev -- expo prebuild --platform android --clean",
    "prebuild-android:smoke": "dotenv -e .env.smoke -- expo prebuild --platform android --clean",
    "prebuild-android:prod": "dotenv -e .env.prod -- expo prebuild --platform android --clean",
    "build-ios:dev": "dotenv -e .env.dev -- eas build --profile development --platform ios",
    "build-ios:smoke": "dotenv -e .env.smoke -- eas build --profile preview --platform ios",
    "build-ios:prod": "dotenv -e .env.prod -- eas build --profile production --platform ios",
    "build-android:dev": "dotenv -e .env.dev -- eas build --profile development --platform android",
    "build-android:smoke": "dotenv -e .env.smoke -- eas build --profile preview --platform android",
    "build-android:prod": "dotenv -e .env.prod -- eas build --profile production --platform android",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.2.2",
    "@shopify/flash-list": "^2.3.1",
    "dotenv-cli": "^11.0.0",
    "expo": "^55.0.15",
    "expo-apple-authentication": "~55.0.13",
    "expo-blur": "^55.0.14",
    "expo-camera": "^55.0.15",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "^55.0.14",
    "expo-image-picker": "^55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.13",
    "expo-router": "^55",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "sonner-native": "^0.25.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "nativewind": "^4.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
